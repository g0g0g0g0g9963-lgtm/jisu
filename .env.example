# Production configuration: all four SSO values are required.
# The server refuses incomplete SSO settings and never permits anonymous production.
NODE_ENV=production
HOST_PORT=3500
HOST=127.0.0.1
PORT=3000
SEED_DEMO=0
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
# Optional employee directory + owner Outlook appointments. Separate incremental consent.
# Generate ONCE: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Store this secret separately from database backups. Never commit it.
MICROSOFT_TOKEN_KEY=
OUTLOOK_REMINDER_MINUTES=10
# Trusted HTTPS origin, no trailing path/query. Redirect URI: APP_BASE_URL/auth/callback
APP_BASE_URL=
# Development only, with NODE_ENV=development or test and all SSO fields empty:
# ALLOW_ANONYMOUS=1

# Private administrator identity. Exactly one Microsoft sign-in email; empty denies everyone.
ADMIN_MS_EMAIL=
# Recommended: Microsoft Entra object ID. Otherwise pinned on the first verified sign-in.
ADMIN_MS_OBJECT_ID=
# Backups are opt-in. Use a private persistent directory OUTSIDE public/dist.
# Schedule disabled with 0. Existing backups are never automatically deleted.
BACKUP_DIR=
BACKUP_INTERVAL_MINUTES=0
BACKUP_MAX_FILES=168
OPS_PRIMARY_CONTACT=
OPS_SECONDARY_CONTACT=
OPS_SLOW_REQUEST_MS=2000
OPS_DISK_WARNING_PERCENT=20
