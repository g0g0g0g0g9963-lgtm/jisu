# 이 파일을 .env 로 복사한 뒤 값을 확인하고 쓴다.

# NAS에서 외부로 열 포트. 기존 컨테이너와 겹치지 않는 값으로.
# (3000은 B급 사후심리 앱이 사용하므로 회의실 예약은 3500)
# 확인 방법: docker ps --format "{{.Names}}\t{{.Ports}}"
HOST_PORT=3500

# 첫 배포 때 예시 예약을 채워 화면을 확인하고 싶으면 1.
# 실제 운영을 시작하면 반드시 0으로 되돌린다. (DB가 비어 있을 때만 동작)
SEED_DEMO=0

# ── Microsoft SSO (Entra ID) ─────────────────────────────────
# 4개를 모두 채우면 로그인이 강제되고, 예약자는 로그인 계정으로 자동 지정된다.
# 하나라도 비어 있으면 익명 모드(이름 직접 입력)로 동작한다.
# 값은 Azure Portal → App registrations → (등록한 앱)에서 확인.
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
# 사용자가 접속하는 주소(https 필수, DSM 역방향 프록시 주소). 예: https://192.168.100.25:3501
APP_BASE_URL=
